// Cardvark's Claude proxy (deployed as the existing Worker "claude-proxy").
// The API key is a secret (CLAUDE_API_KEY), never in this file.
{
  "name": "claude-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-01-29",
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "SCAN_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ]
}
